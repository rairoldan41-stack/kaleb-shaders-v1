local Effects = {}

local function GetEffect(name, class)
    local effect = Lighting:FindFirstChild(name)

    if not effect then
        effect = Instance.new(class)
        effect.Name = name
        effect.Parent = Lighting
    end

    Effects[name] = effect
    return effect
end

