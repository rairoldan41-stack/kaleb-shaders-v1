local function ApplyLighting()
    if not CONFIG.Enabled then return end

    local preset = Presets[CONFIG.Preset]
    if not preset then return end

    Lighting.GlobalShadows = true
    Lighting.Technology = Enum.Technology.Future

    Lighting.ClockTime = preset.Time
    Lighting.Brightness = preset.Brightness
    Lighting.ExposureCompensation = preset.Exposure

    Lighting.EnvironmentDiffuseScale = 0.5
    Lighting.EnvironmentSpecularScale = 0.7

    Lighting.Ambient = Color3.fromRGB(115, 105, 120)
    Lighting.OutdoorAmbient = Color3.fromRGB(155, 145, 140)

    Atmosphere.Density = preset.Density
    Atmosphere.Offset = 0.15
    Atmosphere.Color = Color3.fromRGB(255, 220, 185)
    Atmosphere.Decay = Color3.fromRGB(130, 105, 150)
    Atmosphere.Glare = preset.Glare
    Atmosphere.Haze = preset.Haze

    Rays.Intensity = CONFIG.SunIntensity
    Rays.Spread = 0.78

    Bloom.Intensity = CONFIG.BloomIntensity
    Bloom.Size = 28
    Bloom.Threshold = 1.15

    Color.Brightness = 0.015
    Color.Contrast = preset.Contrast
    Color.Saturation = preset.Saturation
    Color.TintColor = preset.Tint

    Depth.Enabled = false
    Depth.FocusDistance = 50
    Depth.InFocusRadius = 40
    Depth.NearIntensity = 0
    Depth.FarIntensity = 0.08
end

