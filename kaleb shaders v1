local function connect(
    signal: RBXScriptSignal,
    callback: (...any) -> ()
): RBXScriptConnection
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function new<T>(
    className: string,
    properties: { [string]: any }
): T
    local object = Instance.new(className)

    for property, value in properties do
        if property ~= "Parent" then
            (object :: any)[property] = value
        end
    end

    object.Parent = properties.Parent
    return object :: any
end

local function round(parent: Instance, radius: number)
    new("UICorner", {
        CornerRadius = UDim.new(0, radius),
        Parent = parent,
    })
end

local function outline(
    parent: Instance,
    color: Color3,
    transparency: number
)
    new("UIStroke", {
        Color = color,
        Transparency = transparency,
        Thickness = 1,
        Parent = parent,
    })
end

local function animate(
    object: Instance,
    properties: { [string]: any },
    duration: number?
)
    TweenService:Create(
        object,
        TweenInfo.new(
            duration or 0.17,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        ),
        properties
    ):Play()
end

local function directionFromDegrees(degrees: number): Vector3
    local angle = math.rad(degrees)
    return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

local function getEffect(className: string, name: string): Instance
    local effect = Lighting:FindFirstChild(name)

    if effect and effect.ClassName ~= className then
        effect:Destroy()
        effect = nil
    end

    if not effect then
        effect = Instance.new(className)
        effect.Name = name
        effect.Parent = Lighting
    end

    return effect
end

local function isTextInputFocused(): boolean
    return UserInputService:GetFocusedTextBox() ~= nil
end

local function distanceToCamera(position: Vector3): number
    local camera = Workspace.CurrentCamera
    if not camera then
        return math.huge
    end

    return (camera.CFrame.Position - position).Magnitude
end

