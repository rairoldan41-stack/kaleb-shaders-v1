local function registerOcean(instance: Instance)
    if not instance:IsA("BasePart") or oceanParts[instance] then
        return
    end

    if table.getn(CollectionService:GetTagged("KalebOcean"))
        > state.MaxOceanParts
    then
        return
    end

    instance.Anchored = true
    instance.CanCollide = false
    instance.CastShadow = false
    instance.Material = Enum.Material.Glass

    oceanParts[instance] = {
        BaseCFrame = instance.CFrame,
        BaseColor = instance.Color,
        BaseTransparency = instance.Transparency,
        Seed = math.random() * 1000,
        Foam = createFoam(instance),
    }
end

local function unregisterOcean(instance: Instance)
    if not instance:IsA("BasePart") then
        return
    end

    local record = oceanParts[instance]
    if record then
        instance.CFrame = record.BaseCFrame
        instance.Color = record.BaseColor
        instance.Transparency = record.BaseTransparency

        if record.Foam then
            record.Foam:Destroy()
        end
    end

    oceanParts[instance] = nil
end

local function registerWind(instance: Instance)
    if not instance:IsA("BasePart") or windParts[instance] then
        return
    end

    if table.getn(CollectionService:GetTagged("KalebWind"))
        > state.MaxWindParts
    then
        return
    end

    windParts[instance] = {
        BaseCFrame = instance.CFrame,
        Seed = math.random() * 1000,
    }
end

local function unregisterWind(instance: Instance)
    if not instance:IsA("BasePart") then
        return
    end

    local record = windParts[instance]
    if record then
        instance.CFrame = record.BaseCFrame
    end

    windParts[instance] = nil
end

for _, instance in CollectionService:GetTagged("KalebOcean") do
    registerOcean(instance)
end

for _, instance in CollectionService:GetTagged("KalebWind") do
    registerWind(instance)
end

