end

local function makeSlider(
    text: string,
    minimum: number,
    maximum: number,
    initial: number,
    decimals: number,
    callback: (number) -> ()
)
    local row = makeRow(66)
    local value = math.clamp(initial, minimum, maximum)
    local dragging = false

    new("TextLabel", {
        Position = UDim2.fromOffset(13, 7),
        Size = UDim2.new(1, -95, 0, 20),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = CONFIG.Theme.Text,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local valueLabel = new("TextLabel", {
        Position = UDim2.new(1, -87, 0, 7),
        Size = UDim2.fromOffset(73, 20),
        BackgroundTransparency = 1,
        TextColor3 = CONFIG.Theme.Accent2,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    }) :: TextLabel

    local bar = new("Frame", {
        Position = UDim2.fromOffset(13, 42),
        Size = UDim2.new(1, -26, 0, 7),
        BackgroundColor3 = Color3.fromRGB(51, 57, 72),
        BorderSizePixel = 0,
        Active = true,
        Parent = row,
    }) :: Frame
    round(bar, 4)

    local fill = new("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = CONFIG.Theme.Accent,
        BorderSizePixel = 0,
        Parent = bar,
    }) :: Frame
    round(fill, 4)

    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(15, 15),
        BackgroundColor3 = CONFIG.Theme.Text,
        BorderSizePixel = 0,
        Parent = bar,
    }) :: Frame
    round(knob, 8)

    local function render()
        local alpha = (value - minimum) / (maximum - minimum)
        fill.Size = UDim2.fromScale(alpha, 1)
        knob.Position = UDim2.fromScale(alpha, 0.5)
        valueLabel.Text = string.format("%." .. decimals .. "f", value)
    end

    local function setValue(newValue: number, runCallback: boolean?)
        local precision = 10 ^ decimals
        value = math.clamp(newValue, minimum, maximum)
        value = math.round(value * precision) / precision
        render()

        if runCallback ~= false then
            callback(value)
        end
    end

    local function setFromX(x: number)
        if bar.AbsoluteSize.X <= 0 then
            return
        end

        local alpha = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0,
            1
        )

        setValue(minimum + (maximum - minimum) * alpha)
    end

    connect(bar.InputBegan, function(input: InputObject)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            dragging = true
            setFromX(input.Position.X)
        end
    end)

    connect(UserInputService.InputChanged, function(input: InputObject)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            setFromX(input.Position.X)
        end
    end)

    connect(UserInputService.InputEnded, function(input: InputObject)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
        then
            dragging = false
        end
    end)

    render()

    local control = { Set = setValue }
    table.insert(controls, control)
    return control
end

local function makeButton(
    text: string,
    callback: () -> (),
    danger: boolean?
