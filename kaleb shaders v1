local function updateLighting()
    if not state.MasterEnabled then
        return
    end

    Lighting.GlobalShadows = true
    Lighting.Brightness = state.Brightness
    Lighting.ClockTime = state.ClockTime
    Lighting.ExposureCompensation = state.Exposure
    Lighting.GeographicLatitude = state.GeographicLatitude
    Lighting.ShadowSoftness = state.ShadowSoftness
    Lighting.EnvironmentDiffuseScale = state.EnvironmentDiffuse
    Lighting.EnvironmentSpecularScale = state.EnvironmentSpecular

    colorCorrection.Enabled = true
    colorCorrection.Brightness = state.ColorBrightness
    colorCorrection.Contrast = state.Contrast
    colorCorrection.Saturation = state.Saturation
    colorCorrection.TintColor = state.Tint

    bloom.Enabled = state.BloomEnabled
    bloom.Intensity = state.BloomIntensity
    bloom.Size = state.BloomSize
    bloom.Threshold = state.BloomThreshold

    atmosphere.Density = state.AtmosphereEnabled
        and state.AtmosphereDensity
        or 0
    atmosphere.Offset = state.AtmosphereOffset
    atmosphere.Haze = state.AtmosphereEnabled
        and state.AtmosphereHaze
        or 0
    atmosphere.Glare = state.AtmosphereEnabled
        and state.AtmosphereGlare
        or 0
    atmosphere.Color = state.AtmosphereColor
    atmosphere.Decay = state.AtmosphereDecay

    sunRays.Enabled = state.SunRaysEnabled
    sunRays.Intensity = state.SunRaysIntensity
    sunRays.Spread = state.SunRaysSpread

    depthOfField.Enabled = state.DepthOfFieldEnabled
    depthOfField.FarIntensity = state.DOFFarIntensity
    depthOfField.NearIntensity = state.DOFNearIntensity
    depthOfField.FocusDistance = state.DOFFocusDistance
    depthOfField.InFocusRadius = state.DOFInFocusRadius
end

local function updateWater()
    if not state.MasterEnabled then
        return
    end

    terrain.WaterColor = state.WaterColor
    terrain.WaterTransparency = state.TerrainWaterEnabled
        and state.WaterTransparency
        or 1
    terrain.WaterReflectance = state.WaterReflectance
    terrain.WaterWaveSize = state.TerrainWaterEnabled
        and state.WaterWaveSize
        or 0
    terrain.WaterWaveSpeed = state.TerrainWaterEnabled
        and state.WaterWaveSpeed
        or 0

    for part, record in oceanParts do
        if part.Parent then
            part.Transparency = state.CustomOceanEnabled
                and state.OceanTransparency
                or 1
            part.Color = state.OceanBaseColor

            if record.Foam then
                record.Foam.Enabled =
                    state.CustomOceanEnabled and state.FoamEnabled
            end
        end
    end
end

local function updateSunAppearance()
    sunRoot.Size = UDim2.fromOffset(state.SunSize, state.SunSize)
    sunDisk.BackgroundColor3 = state.SunColor
    sunDisk.BackgroundTransparency = 1 - state.SunOpacity
    sunHalo.BackgroundColor3 = state.SunColor
    sunHalo.Size = UDim2.fromScale(
        state.SunHaloSize,
        state.SunHaloSize
    )
    sunHalo.BackgroundTransparency = 1 - state.SunHaloOpacity

    diskGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 245)),
        ColorSequenceKeypoint.new(0.58, state.SunColor),
        ColorSequenceKeypoint.new(1, state.SunEdgeColor),
    })

    raysRoot.Visible = state.ScreenRaysEnabled
    flareRoot.Visible = state.LensFlareEnabled

    rebuildScreenRays()
end

local function restoreOriginal()
    Lighting.Brightness = original.Brightness
    Lighting.ClockTime = original.ClockTime
    Lighting.ExposureCompensation = original.Exposure
    Lighting.GeographicLatitude = original.GeographicLatitude
    Lighting.Ambient = original.Ambient
    Lighting.OutdoorAmbient = original.OutdoorAmbient
    Lighting.ShadowSoftness = original.ShadowSoftness
    Lighting.GlobalShadows = original.GlobalShadows
    Lighting.EnvironmentDiffuseScale = original.EnvironmentDiffuseScale
    Lighting.EnvironmentSpecularScale = original.EnvironmentSpecularScale

    terrain.WaterColor = original.WaterColor
    terrain.WaterTransparency = original.WaterTransparency
    terrain.WaterReflectance = original.WaterReflectance
    terrain.WaterWaveSize = original.WaterWaveSize
    terrain.WaterWaveSpeed = original.WaterWaveSpeed

    Workspace.GlobalWind = original.GlobalWind

    colorCorrection.Enabled = false
    bloom.Enabled = false
    sunRays.Enabled = false
    depthOfField.Enabled = false

    sunRoot.Visible = false
    flareRoot.Visible = false

    for part, record in oceanParts do
        if part.Parent then
            part.CFrame = record.BaseCFrame
            part.Color = record.BaseColor
            part.Transparency = record.BaseTransparency
        end
    end

    for part, record in windParts do
        if part.Parent then
            part.CFrame = record.BaseCFrame
        end
    end
end

local function setMasterEnabled(enabled: boolean)
    state.MasterEnabled = enabled

    if enabled then
        updateLighting()
        updateWater()
        updateSunAppearance()
    else
        restoreOriginal()
    end
end

local function applyPreset(name: string)
    local preset = CONFIG.Presets[name]
    if not preset then
        return
    end

    activePreset = name

    for key, value in preset do
        (state :: any)[key] = value
    end

    updateLighting()
    updateWater()
    updateSunAppearance()
end

