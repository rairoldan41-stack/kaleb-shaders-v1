local function rebuildScreenRays()
    for _, ray in rayFrames do
        ray:Destroy()
    end
    table.clear(rayFrames)

    local count = math.clamp(math.floor(state.ScreenRaysCount), 4, 28)

    for index = 1, count do
        local lengthVariation = 0.65 + ((index * 37) % 100) / 100
        local widthVariation = 0.35 + ((index * 53) % 100) / 100

        local ray = new("Frame", {
            Name = `Ray_{index}`,
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(
                0,
                6 + 17 * widthVariation,
                state.ScreenRaysLength * lengthVariation,
                0
            ),
            Rotation = (360 / count) * index,
            BackgroundColor3 = state.SunColor,
            BackgroundTransparency = 1 - state.ScreenRaysOpacity,
            BorderSizePixel = 0,
            Parent = raysRoot,
        }) :: Frame

        new("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.3, 0.65),
                NumberSequenceKeypoint.new(0.72, 0.85),
                NumberSequenceKeypoint.new(1, 1),
            }),
            Parent = ray,
        })

        table.insert(rayFrames, ray)
    end
end

