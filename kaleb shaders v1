    end)

    connect(button.MouseLeave, function()
        animate(button, {
            BackgroundColor3 = danger
                and CONFIG.Theme.Danger
                or CONFIG.Theme.Panel,
        }, 0.12)
    end)

    connect(button.Activated, callback)
end

