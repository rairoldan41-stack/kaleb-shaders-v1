--==============================================================
-- MENU MÓVEL
--==============================================================

local draggingMenu = false
local dragStart = Vector2.zero
local windowStart = Vector2.zero

local function clampWindow(position: Vector2): UDim2
    local camera = Workspace.CurrentCamera
    if not camera then
        return UDim2.fromOffset(position.X, position.Y)
    end

    local viewport = camera.ViewportSize
    local size = main.AbsoluteSize

    return UDim2.fromOffset(
        math.clamp(position.X, 0, math.max(0, viewport.X - size.X)),
        math.clamp(position.Y, 0, math.max(0, viewport.Y - size.Y))
    )
end

connect(header.InputBegan, function(input: InputObject)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
    then
        draggingMenu = true
        dragStart = input.Position
        windowStart = main.AbsolutePosition
    end
end)

connect(UserInputService.InputChanged, function(input: InputObject)
    if draggingMenu and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        main.Position = clampWindow(
            windowStart + input.Position - dragStart
        )
    end
end)

connect(UserInputService.InputEnded, function(input: InputObject)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
    then
        draggingMenu = false
    end
end)

--==============================================================
-- ABRIR E FECHAR
--==============================================================

local normalSize = main.Size

local function setMenuOpen(open: boolean)
    menuOpen = open

    if open then
        main.Visible = true
        main.Size = UDim2.fromOffset(360, 540)
        main.BackgroundTransparency = 0.15

        animate(main, {
            Size = normalSize,
            BackgroundTransparency = 0,
        }, 0.2)
    else
        animate(main, {
            Size = UDim2.fromOffset(360, 540),
            BackgroundTransparency = 1,
        }, 0.15)

        task.delay(0.15, function()
            if alive and not menuOpen then
                main.Visible = false
            end
        end)
    end
end

connect(closeButton.Activated, function()
    setMenuOpen(false)
end)

connect(UserInputService.InputBegan, function(
    input: InputObject,
    processed: boolean
)
    if processed or isTextInputFocused() then
        return
    end

    if input.KeyCode == CONFIG.ToggleKey then
        setMenuOpen(not menuOpen)
    end
end)

--==============================================================
-- MATEMÁTICA DAS ONDAS GERSTNER
--==============================================================

local TAU = math.pi * 2

local function gerstnerWave(
    position: Vector3,
    direction: Vector3,
    wavelength: number,
    amplitude: number,
    steepness: number,
    speed: number,
    time: number
): (Vector3, Vector3, number)
    local safeLength = math.max(wavelength, 0.01)
    local waveNumber = TAU / safeLength
    local phaseSpeed = math.sqrt(Workspace.Gravity / waveNumber)
    local phase =
        waveNumber * (
            direction.X * position.X
            + direction.Z * position.Z
            - phaseSpeed * speed * time
        )

    local sine = math.sin(phase)
    local cosine = math.cos(phase)
    local horizontal = steepness * amplitude * cosine

    local displacement = Vector3.new(
        direction.X * horizontal,
        amplitude * sine,
        direction.Z * horizontal
    )

    local normal = Vector3.new(
        -direction.X * waveNumber * amplitude * cosine,
        1 - steepness * waveNumber * amplitude * sine,
        -direction.Z * waveNumber * amplitude * cosine
    ).Unit

    return displacement, normal, sine
end

local function sampleOcean(
    position: Vector3,
    time: number
): (Vector3, Vector3, number)
    local primaryDirection = directionFromDegrees(state.WaveDirection)
    local secondaryDirection =
        directionFromDegrees(state.WaveDirection + 57)
    local detailDirection =
        directionFromDegrees(state.WaveDirection - 31)

    local displacementA, normalA, crestA = gerstnerWave(
        position,
        primaryDirection,
        state.WaveLength,
        state.WaveHeight,
        state.WaveSteepness,
        state.WaveSpeed,
        time
    )

    local displacementB, normalB, crestB = gerstnerWave(
        position,
        secondaryDirection,
        state.WaveLength * 0.53,
        state.WaveHeight * state.SecondaryWaveStrength,
        state.WaveSteepness * 0.7,
        state.WaveSpeed * 1.17,
        time
    )

    local displacementC, normalC, crestC = gerstnerWave(
        position,
        detailDirection,
        state.WaveLength * 0.21,
        state.WaveHeight * state.DetailWaveStrength,
        state.WaveSteepness * 0.45,
        state.WaveSpeed * 1.65,
        time
    )

    local displacement =
        displacementA + displacementB + displacementC

    displacement = Vector3.new(
        displacement.X * state.WaveChoppiness,
        displacement.Y,
        displacement.Z * state.WaveChoppiness
    )

    local normal = (normalA + normalB + normalC).Unit
    local crest = (
        crestA
        + crestB * state.SecondaryWaveStrength
        + crestC * state.DetailWaveStrength
    ) / (
        1
        + state.SecondaryWaveStrength
        + state.DetailWaveStrength
    )

    return displacement, normal, crest
end

--==============================================================
-- MOTOR DE ANIMAÇÃO
--==============================================================

local elapsed = 0
local accumulated = 0
local smoothedExposure = state.Exposure
local sunRotation = 0

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.IgnoreWater = true

local function updateVisualSun(deltaTime: number)
    local camera = Workspace.CurrentCamera
    if not camera then
        sunRoot.Visible = false
        return
    end

    -- Direção aproximada compatível com ClockTime e latitude.
    local hourAngle = ((state.ClockTime - 12) / 24) * TAU
    local latitude = math.rad(state.GeographicLatitude)

    local sunDirection = Vector3.new(
        math.sin(hourAngle),
        math.cos(hourAngle) * math.cos(latitude),
        -math.cos(hourAngle) * math.sin(latitude)
    ).Unit

    local worldPosition =
        camera.CFrame.Position + sunDirection * 10000

    local screenPoint, visible =
        camera:WorldToViewportPoint(worldPosition)

    local inFront = screenPoint.Z > 0
    local shouldShow =
        state.MasterEnabled
        and state.VisualSunEnabled
        and visible
        and inFront

    sunRoot.Visible = shouldShow
    flareRoot.Visible =
        shouldShow and state.LensFlareEnabled

    if not shouldShow then
        return
    end

    local viewport = camera.ViewportSize
    local position = Vector2.new(screenPoint.X, screenPoint.Y)

    sunRoot.Position = UDim2.fromOffset(position.X, position.Y)

    sunRotation += deltaTime * state.ScreenRaysRotationSpeed
    raysRoot.Rotation = sunRotation

    local center = viewport / 2
    local vectorToCenter = center - position

    for index, element in flareElements do
        local alpha = index / (#flareElements + 1)
        local flarePosition =
            position + vectorToCenter * (alpha * 1.45)

        element.Position = UDim2.fromOffset(
            flarePosition.X,
            flarePosition.Y
        )

        element.BackgroundTransparency =
            math.clamp(
                1 - state.LensFlareIntensity
                    + index * 0.035,
                0,
                1
            )
    end
end

local function updateOcean(time: number)
    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    for part, record in oceanParts do
        if not part.Parent then
            oceanParts[part] = nil
            continue
        end

        if not state.CustomOceanEnabled
            or distanceToCamera(record.BaseCFrame.Position)
                > state.AnimationDistance
        then
            part.CFrame = record.BaseCFrame
            continue
        end

        local displacement, normal, crest = sampleOcean(
            record.BaseCFrame.Position,
            time + record.Seed * 0.01
        )

        local up = normal
        local forward = Vector3.new(0, 0, -1)

        if math.abs(up:Dot(forward)) > 0.97 then
            forward = Vector3.new(1, 0, 0)
        end

        local right = forward:Cross(up).Unit
        local correctedForward = up:Cross(right).Unit

        part.CFrame = CFrame.fromMatrix(
            record.BaseCFrame.Position + displacement,
            right,
            up,
            -correctedForward
        )

        local fresnel = math.clamp(
            1 - math.abs(normal:Dot(
                (camera.CFrame.Position - part.Position).Unit
            )),
            0,
            1
        )

        local heightBlend = math.clamp(
            (displacement.Y / math.max(state.WaveHeight, 0.01) + 1) / 2,
            0,
            1
        )

        local waterColor = state.OceanDeepColor:Lerp(
            state.OceanBaseColor,
            heightBlend
        ):Lerp(
            state.OceanShallowColor,
            fresnel * 0.55
        )

        part.Color = waterColor
        part.Transparency = math.clamp(
            state.OceanTransparency - fresnel * 0.12,
            0,
            1
        )

        local foamAmount = math.clamp(
            (crest - state.FoamThreshold)
                / math.max(1 - state.FoamThreshold, 0.01),
            0,
            1
        )

        if record.Foam then
            record.Foam.Enabled = state.FoamEnabled

            local foamFrame =
                record.Foam:FindFirstChild("Foam") :: Frame?

            if foamFrame then
                foamFrame.BackgroundTransparency =
                    1 - foamAmount * state.FoamOpacity

                local gradient =
                    foamFrame:FindFirstChildOfClass("UIGradient")

                if gradient then
                    gradient.Offset = Vector2.new(
                        (
                            time
                            * state.FoamSpeed
                            + record.Seed
                        ) % 2 - 1,
                        math.sin(
                            time * state.FoamSpeed
                            + record.Seed
                        ) * 0.15
                    )
                end
            end
        end
    end
end

local function updateWind(time: number)
    if not state.WindEnabled then
        Workspace.GlobalWind = Vector3.zero

        for part, record in windParts do
            if part.Parent then
                part.CFrame = record.BaseCFrame
            end
        end

        return
    end

    local direction = directionFromDegrees(state.WindDirection)

    local gustNoise = math.noise(
        time * state.GustFrequency,
        0,
        0
    )

    local gustMultiplier =
        1 + gustNoise * state.WindTurbulence

    Workspace.GlobalWind = Vector3.new(
        direction.X * state.WindSpeed * gustMultiplier,
        state.WindVertical * math.max(0, gustNoise),
        direction.Z * state.WindSpeed * gustMultiplier
    )

    for part, record in windParts do
        if not part.Parent then
            windParts[part] = nil
            continue
        end

        if distanceToCamera(record.BaseCFrame.Position)
            > state.AnimationDistance
        then
            part.CFrame = record.BaseCFrame
            continue
        end

        local localNoise = math.noise(
            record.BaseCFrame.Position.X * 0.03,
            record.BaseCFrame.Position.Z * 0.03,
            time * state.GustFrequency
        )

        local sway =
            (
                math.sin(
                    time * state.WindSpeed * 0.18
                    + record.Seed
                ) * 0.7
                + localNoise * state.WindTurbulence
            )
            * state.WindStrength
            * gustMultiplier

        part.CFrame =
            record.BaseCFrame
            * CFrame.Angles(
                -direction.Z * sway * 0.13,
                localNoise * 0.025,
                direction.X * sway * 0.13
            )
    end
end

local function updateDynamicExposure(deltaTime: number)
    if not state.DynamicExposure then
        Lighting.ExposureCompensation = state.Exposure
        smoothedExposure = state.Exposure
        return
    end

    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    local character = player.Character
    raycastParams.FilterDescendantsInstances =
        character and { character } or {}

    local ceiling = Workspace:Raycast(
        camera.CFrame.Position,
        Vector3.new(0, 350, 0),
        raycastParams
    )

    local target =
        state.Exposure
        + (
            ceiling
                and state.IndoorExposure
                or state.OutdoorExposure
        )

    local alpha = 1 - math.exp(
        -state.ExposureAdaptation * deltaTime
    )

    smoothedExposure +=
        (target - smoothedExposure) * alpha

    Lighting.ExposureCompensation = smoothedExposure
end

RunService:UnbindFromRenderStep("KalebShadersUltra")

RunService:BindToRenderStep(
    "KalebShadersUltra",
    Enum.RenderPriority.Camera.Value + 2,
    function(deltaTime: number)
        if not alive or not state.MasterEnabled then
            return
        end

        elapsed += deltaTime
        accumulated += deltaTime

        updateVisualSun(deltaTime)
        updateDynamicExposure(deltaTime)

        local interval = 1 / math.max(state.UpdateRate, 1)

        if accumulated >= interval then
            local step = accumulated
            accumulated = 0

            updateOcean(elapsed)
            updateWind(elapsed)

            -- Mantém o horário controlado pelo menu.
            Lighting.ClockTime = state.ClockTime

            -- O disco nativo não pode ser removido diretamente.
            -- Desabilitá-lo reduz sua presença usando o horário noturno,
            -- enquanto o sol visual continua independente.
            if not state.NativeSunEnabled then
                sunRays.Enabled = false
            else
                sunRays.Enabled = state.SunRaysEnabled
            end
        end
    end
)

